#!/usr/bin/env bash

set -e

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

backup_link_conflict() {
    local target=$1
    local backup

    if [[ ! -e $target || -L $target ]]; then
        return 0
    fi

    backup="${target}.dotfiles-backup.$(date +%Y%m%d%H%M%S)"
    if [[ -e $backup || -L $backup ]]; then
        backup="${backup}.$$"
    fi

    echo "Backing up existing $target to $backup"
    mv "$target" "$backup"
}

# Dotbot 1.20 does not have native conflict backups. Preserve the two imported
# application configs before replacing them with managed links.
backup_link_conflict "$HOME/.aerospace.toml"
backup_link_conflict "$HOME/.config/ghostty"

DOTBOT_STATE=$(git submodule status "${DOTBOT_DIR}" 2>/dev/null || true)
if [[ ! -x "${DOTBOT_DIR}/${DOTBOT_BIN}" || $DOTBOT_STATE == [-+U]* ]]; then
    git submodule sync --quiet --recursive "${DOTBOT_DIR}"
    git submodule update --init --recursive "${DOTBOT_DIR}"
fi

"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"
